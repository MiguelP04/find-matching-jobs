{
  "name": "find-matching-jobs",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "dev:backend": "pnpm --filter backend run start:dev",
    "dev:matching": "cd apps/backend/python-services/matching-service && .venv\\Scripts\\uvicorn app.main:app --reload --port 8000",
    "dev": "concurrently \"pnpm run dev:backend\" \"pnpm run dev:matching\""
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
