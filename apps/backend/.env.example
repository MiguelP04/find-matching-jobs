# Server
PORT=3000
NODE_ENV=development

# Database (PostgreSQL)
# For local setup:
# DATABASE_URL=postgresql://user:password@localhost:5432/find_matching_jobs
# For Neon Cloud:
DATABASE_URL=postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require&channel_binding=require

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# JSearch API (RapidAPI)
JSEARCH_API_KEY=your-rapidapi-jsearch-key

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3001

# Google OAuth
GOOGLE_CLIENT_ID=tu-google-client-id
GOOGLE_CLIENT_SECRET=tu-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Gemini AI
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
